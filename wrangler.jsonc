{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findimageai",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "findimageai"
    }
  ],
  "keep_vars": true,
  "observability": { "enabled": true }
}
